APP_NAME=Smart Sales Agency
ENVIRONMENT=development
DATABASE_URL=sqlite:///./sales_agency.db

# demo = no paid API required
# openai_compatible = OpenAI, Groq, OpenRouter, local compatible server, etc.
LLM_MODE=demo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45

# Keep true for the MVP. Messages are never sent without approval.
REQUIRE_HUMAN_APPROVAL=true
DEFAULT_CHANNEL=console

# Inbound integration credentials are persisted as one-way hashes in the database.
# Do not put integration keys in this file.

# Provider webhook secrets are runtime-only configuration, never database values.
# Set a variable named by an IntegrationAccount's internal secret_reference.
# References must use the INTEGRATION_SECRET_ namespace and uppercase letters,
# numbers, or underscores (for example, INTEGRATION_SECRET_GENERIC_HMAC).
INTEGRATION_SECRET_GENERIC_HMAC=replace-with-a-secret
WEBHOOK_MAX_AGE_SECONDS=300

# Explicit audit-retention cleanup uses this provider-neutral age policy.
# API reads and lifecycle operations never delete audit history.
INTEGRATION_ACCOUNT_AUDIT_RETENTION_DAYS=90

# Explicit outbound retry policy. Other safe failure codes are retryable by default.
OUTBOUND_DELIVERY_MAX_ATTEMPTS=3
OUTBOUND_DELIVERY_NON_RETRYABLE_FAILURE_CODES=
OUTBOUND_DELIVERY_NON_RETRYABLE_FAILURE_CLASSES=
OUTBOUND_DELIVERY_RETRY_DELAY_STRATEGY=fixed
OUTBOUND_DELIVERY_RETRY_DELAY_SECONDS=0
OUTBOUND_DELIVERY_RETRY_DELAY_MAX_SECONDS=3600

# Optional generic HTTP outbound adapter. It is provider-neutral and can target
# any compatible service; no endpoint or secret is stored in the database.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_CONNECT_TIMEOUT_SECONDS=5
OUTBOUND_WEBHOOK_READ_TIMEOUT_SECONDS=15
