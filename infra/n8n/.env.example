# Self-hosted n8n runtime for the Task 285 smoke harness.
# Values here are placeholders only. Keep runtime secrets out of source control.

N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.30.5
N8N_CONTAINER_NAME=smart-sales-task285-n8n
N8N_HOST_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/

# Generate a stable secret per local runtime so n8n can decrypt its persistent
# /home/node/.n8n data volume after restarts.
N8N_ENCRYPTION_KEY=replace-with-a-generated-local-secret

# Windows and Docker Desktop usually reach the host FastAPI process through
# host.docker.internal. Override this on Linux if your Docker setup needs a
# different host gateway.
SSA_FASTAPI_BASE_URL_FROM_N8N=http://host.docker.internal:8000

# These are injected by scripts/smoke_n8n_runtime.py. Do not commit real values.
SSA_INBOUND_INTEGRATION_KEY=replace-at-runtime
SSA_INBOUND_HMAC_SECRET=replace-at-runtime
SSA_OUTBOUND_HMAC_SECRET=replace-at-runtime

# Task 286 WhatsApp Cloud bridge placeholders. The Meta values belong at the
# n8n transport edge; do not commit real tokens or app secrets.
SSA_WHATSAPP_CLOUD_INTEGRATION_KEY=replace-at-runtime
SSA_WHATSAPP_CLOUD_HMAC_SECRET=replace-at-runtime
WHATSAPP_CLOUD_VERIFY_TOKEN=replace-at-runtime
WHATSAPP_CLOUD_APP_SECRET=replace-at-runtime
WHATSAPP_CLOUD_PHONE_NUMBER_ID=555666777888999
WHATSAPP_CLOUD_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_CLOUD_GRAPH_API_VERSION=replace-at-runtime

GENERIC_TIMEZONE=UTC
TZ=UTC
