    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst bodyObject = $json.body ?? {};\nconst rawBody = JSON.stringify(bodyObject);\nconst headers = $json.headers ?? {};\nconst timestamp = headers['x-webhook-timestamp'] || headers['X-Webhook-Timestamp'];\nconst signature = headers['x-webhook-signature'] || headers['X-Webhook-Signature'];\nconst signing = headers['x-webhook-signing'] || headers['X-Webhook-Signing'];\nconst secret = $env.SSA_OUTBOUND_HMAC_SECRET;\nif (signing !== 'hmac-sha256' || !timestamp || !signature || !secret) {\n  throw new Error('Outbound webhook signature is missing');\n}\nconst expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nif (!crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected))) {\n  throw new Error('Outbound webhook signature mismatch');\n}\nreturn [{\n  json: {\n    accepted: true,\n    transport: 'n8n',\n    delivery_id: `n8n-task285-${bodyObject.action_id}`,\n    action_id: bodyObject.action_id,\n    action_type: bodyObject.action_type,\n    external_target_id: bodyObject.external_target_id\n  }\n}];"
