      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst bodyObject = $json.body ?? {};\nconst body = JSON.stringify(bodyObject);\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst secret = $env.SSA_INBOUND_HMAC_SECRET;\nconst integrationKey = $env.SSA_INBOUND_INTEGRATION_KEY;\nconst baseUrl = ($env.SSA_FASTAPI_BASE_URL_FROM_N8N || '').replace(/\\/$/, '');\nif (!secret || !integrationKey || !baseUrl) {\n  throw new Error('Task 285 n8n runtime environment is incomplete');\n}\nconst incomingHeaders = $json.headers ?? {};\nconst eventId = incomingHeaders['x-integration-event-id'] || incomingHeaders['X-Integration-Event-Id'] || bodyObject.external_event_id || `task285-${$execution.id}`;\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${body}`).digest('hex');\nreturn [{\n  json: {\n    url: `${baseUrl}/api/integrations/inbound-events`,\n    body,\n    headers: {\n      'Content-Type': 'application/json',\n      'X-Integration-Key': integrationKey,\n      'X-Webhook-Timestamp': timestamp,\n      'X-Webhook-Signature': signature,\n      'X-Integration-Event-Id': eventId\n    }\n  }\n}];"
